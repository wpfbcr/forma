{
  "name": "forma",
  "version": "0.2.0-alpha.7",
  "description": "A local-first personal AI workspace for your agents and teams",
  "author": "Forma contributors",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build:core && node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "build:core": "tsc -p tsconfig.json",
    "bench:retrieval": "npm run build:core && node benchmarks/retrieval.cjs",
    "docs:check": "node scripts/check-docs.mjs",
    "licenses:generate": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "org.forma.desktop",
    "productName": "Forma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt",
      "resources/skills/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpfbcr/forma.git"
  },
  "homepage": "https://github.com/wpfbcr/forma#readme",
  "bugs": {
    "url": "https://github.com/wpfbcr/forma/issues"
  }
}
